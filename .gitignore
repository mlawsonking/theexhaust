# Claude Code session-local settings (personal, per-machine)
.claude/settings.local.json

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Local secrets / credentials — NEVER commit. R2 keys, ntfy topics, healthchecks URLs live in
# GitHub Actions secrets (R1) and local environment (R2). No key in the repo, ever.
.env
*.local.env
secrets.local*
*.pem

# Local archival scratch — the durable archive is R2, not the repo tree
/local-archive/
/scratch/

# Retrocast working cache: content-addressed copies of archived R2 objects (GBs) plus pickled
# feature builds. Re-hashed against the pins on every run, so a stale cache cannot change a
# result — it only saves the download. The archive is authoritative; this is never evidence.
/.cache/

# Generated static site (rebuilt by sitegen; deployed by Cloudflare Pages build)
/site/dist/

# Compiled derived layer (artifacts.compile rebuilds it from the archive on every deploy). The
# ARCHIVE is authoritative and the receipts bundles below are the committed public record; caching
# a megabyte of re-derivable notice tables in git history would just bloat the repo.
/site/data/
